# Safe for browser use: project URL and anon/publishable key only.
# Never put SUPABASE_SERVICE_ROLE_KEY or a database password in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Required on the Vercel server when AI is enabled. These are publishable values,
# used only to validate signed-in sessions; never set a service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional server-only AI provider settings. Never prefix AI_API_KEY with VITE_.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
